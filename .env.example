# AURA AI — Environment Configuration

# GEMINI_API_KEY: Required for live Google Gemini AI generation.
# If omitted or invalid, AURA automatically operates with its internal local fallback engine.
GEMINI_API_KEY=""

# GEMINI_MODEL: Active Gemini model identifier.
# Supported allowlist: gemini-2.5-flash (default), gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-2.5-flash"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Rate Limiting
# RATE_LIMIT_WINDOW_MS: Window in milliseconds (default 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX: Maximum requests permitted per window per client IP
RATE_LIMIT_MAX=60
