# PostgreSQL & Supabase Database Configuration
DATABASE_URL="postgresql://postgres:postgres@db.yaefxmttfslbdbiljrdx.supabase.co:5432/postgres?sslmode=require"
VITE_SUPABASE_URL="https://yaefxmttfslbdbiljrdx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_mpHtKdfe6u9cMhlAjQQBsw_djcu6byW"

# Authentication Session Secret (Optional cookie signing / secret)
AUTH_SESSION_SECRET="aura_production_secure_secret_key_32_bytes_min"

# GEMINI_API_KEY: Required for live Google Gemini AI generation.
# If omitted or invalid, AURA automatically operates with its internal local fallback engine.
GEMINI_API_KEY=""

# GEMINI_MODEL: Active Gemini model identifier.
# Supported allowlist: gemini-2.5-flash (default), gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-2.5-flash"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Rate Limiting
# RATE_LIMIT_WINDOW_MS: Window in milliseconds (default 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX: Maximum requests permitted per window per client IP
RATE_LIMIT_MAX=60
